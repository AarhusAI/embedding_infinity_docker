upstream api_e5 {
    server e5-large:7997;

    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 65s;
}

upstream api_bge {
    server bge-m3:7997;

    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 65s;
}

upstream api_reranker {
    server bge-reranker:7997;

    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 65s;
}

server {
    listen ${NGINX_PORT};
    server_name localhost;

    client_body_buffer_size 10M;
    client_max_body_size 100M;

    set_real_ip_from 172.16.0.0/16;
    set_real_ip_from 192.168.39.0/24;
    real_ip_recursive on;
    real_ip_header X-Forwarded-For;

    proxy_buffering off;
    proxy_request_buffering off;

    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;

    location = /_authz {
        internal;
        proxy_pass http://authz:8000/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Original-Authorization $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /bge/ {
        auth_request /_authz;

        proxy_pass http://api_bge/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /reranker/ {
        auth_request /_authz;

        proxy_pass http://api_reranker/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        auth_request /_authz;

        proxy_pass http://api_e5/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    error_log /dev/stderr;
    access_log /dev/stdout main;
}
