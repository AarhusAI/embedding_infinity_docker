COMPOSE_PROJECT_NAME=embedding-infinity
COMPOSE_DOMAIN=embeddings.localhost
COMPOSE_SERVER_DOMAIN=

# Image — pin to a release tag in production (e.g. michaelf34/infinity:0.0.76).
INFINITY_IMAGE_VERSION=latest

# Traefik project + hostnames. COMPOSE_PROJECT_NAME also names the router so
# it must be unique per deployment on the same Traefik instance.


# Reserved for a future /metrics endpoint guarded by an nginx allow rule.
# Currently passed into the nginx container but not referenced by any template;
# leave blank.
NGINX_ALLOW_METRICS_IP=

# --- GPU / models ------------------------------------------------------------

# Per-service GPU index (only used by docker-compose.server.yml). Set all to
# "0" to co-locate on a single card; spread across cards as needed.
BGE_M3_GPU=0
E5_LARGE_GPU=0
BGE_RERANKER_GPU=0

# Batch sizes. Compose defaults: CPU base 8/8/8, GPU override 16/32/8
# (bge-m3 and bge-reranker are conservative because of bge-m3's 8 k-token
# context and the reranker's query+doc pair inflation). Pin here to override
# either environment — server has a single 16 GB GPU shared by all three
# services, so leave headroom when raising these.
# BGE_M3_BATCH_SIZE=
# E5_LARGE_BATCH_SIZE=
# BGE_RERANKER_BATCH_SIZE=

# Only required for gated/private models. bge-m3 and e5-large are public.
HF_TOKEN=

LOG_LEVEL=info
